{
  "browser": {
    "headless": false,
    "max_steps": 250,
    "timeout_seconds": 120,
    "viewport_width": 1280,
    "viewport_height": 800,
    "capture_screenshots": true,
    "wait_for_network_idle_page_load_time": 2.5
  },
  "llm": {
    "provider": "gemini",
    "model_name": "gemini-2.5-flash",
    "fallback_model_name": "gemini-1.5-pro",
    "max_retries": 5,
    "temperature": 0.1,
    "api_key": ""
  },
  "rate_limit": {
    "requests_per_minute": 15,
    "inter_entity_delay_seconds": 5.0,
    "backoff_on_error_seconds": 15.0
  },
  "queue": {
    "max_retries": 3,
    "batch_size": 10,
    "retry_delay_seconds": 5
  },
  "paths": {
    "db_path": "../Funding.sqlite",
    "prompt_template_path": "prompts/browser_prompt.txt",
    "logs_dir": "logs",
    "outputs_dir": "outputs",
    "screenshots_dir": "screenshots"
  }
}
